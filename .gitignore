# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Paketleme / PyInstaller
build/
dist/
*.egg-info/
*.spec

# Sanal ortamlar
.venv/
venv/
env/
.env

# Test / araç önbellekleri
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Proje verisi ────────────────────────────────────────
# Veritabanı, videolar, modeller, alan şablonları ve loglar
# kullanıcıya özeldir; repoya yalnızca boş klasör girer.
/dosyalar/*
!/dosyalar/.gitkeep

# Model ağırlıkları ve dışa aktarılmış modeller (her yerde)
*.pt
*.onnx
*.engine
*_openvino_model/

# Ultralytics eğitim çıktıları
runs/

# SQLite ve loglar (dosyalar/ dışında oluşursa)
*.db
*.db-journal
*.log

# ── Editör / işletim sistemi ────────────────────────────
.vscode/
.idea/
tempCodeRunnerFile.py
.DS_Store
Thumbs.db
desktop.ini